{
  "name": "newtonite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev --workspace @newtonite/api\" \"npm run dev --workspace @newtonite/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @newtonite/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @newtonite/api",
    "db:seed": "npm run db:seed --workspace @newtonite/api",
    "db:demo-accounts:preview": "npm run db:demo-accounts:preview --workspace @newtonite/api",
    "db:demo-accounts:update": "npm run db:demo-accounts:update --workspace @newtonite/api",
    "worker": "npm run worker --workspace @newtonite/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prisma": "^8.0.0-rc.23",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
